<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Pentru update-ul din aplicație (APK-uri din GitHub Releases). -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <!-- Rândul „Watch Next” și canalul aplicației pe ecranul principal Android TV. -->
  <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

  <queries>
    <!-- Furnizorul TV al sistemului (Watch Next, canale) și recunoașterea vocală (căutare vocală). -->
    <provider android:authorities="android.media.tv" />
    <intent>
      <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
    </intent>
  </queries>

  <uses-feature
    android:name="android.software.leanback"
    android:required="false" />
  <uses-feature
    android:name="android.hardware.touchscreen"
    android:required="false" />

  <application
    android:name=".AkVodHubApp"
    android:allowBackup="false"
    android:banner="@drawable/banner"
    android:icon="@drawable/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.AkVodHub"
    android:usesCleartextTraffic="true">
    <!-- usesCleartextTraffic: multe servere IPTV merg doar pe http://. -->

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:screenOrientation="sensorLandscape">
      <!-- sensorLandscape: pe telefon interfața de TV rămâne pe orizontală; pe TV nu schimbă nimic. -->
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
      </intent-filter>
      <!-- Linkuri de pe ecranul principal și din căutarea globală: akvodhub://title/<id>, akvodhub://play/<id>. -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="akvodhub" />
      </intent-filter>
      <!-- Căutare (globală, vocală, din Asistent): textul ajunge în ecranul Căutare. -->
      <intent-filter>
        <action android:name="android.intent.action.SEARCH" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
      <intent-filter>
        <action android:name="com.google.android.gms.actions.SEARCH_ACTION" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
      <meta-data
        android:name="android.app.searchable"
        android:resource="@xml/searchable" />
    </activity>

    <activity
      android:name=".player.PlayerActivity"
      android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
      android:exported="false"
      android:launchMode="singleTop"
      android:screenOrientation="sensorLandscape" />

    <!-- Sugestii pentru căutarea globală Android TV (doar sistemul de căutare le poate citi). -->
    <provider
      android:name=".tv.SearchProvider"
      android:authorities="${applicationId}.search"
      android:exported="true"
      android:readPermission="android.permission.GLOBAL_SEARCH" />

    <receiver
      android:name=".update.InstallResultReceiver"
      android:exported="false" />

    <!-- WorkManager se inițializează din AkVodHubApp (fabrica de worker-e), nu automat. -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>
  </application>
</manifest>
